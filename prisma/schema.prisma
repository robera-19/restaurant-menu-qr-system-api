generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id                   String     @id @default(uuid()) @db.Uuid
  fullName             String     @map("full_name") @db.VarChar(100)
  email                String     @unique @db.VarChar(150)
  passwordHash         String     @map("password_hash")
  role                 Role       @default(ADMIN)
  profileImage         String?    @map("profile_image")
  isActive             Boolean    @default(true) @map("is_active")
  isVerified           Boolean    @default(false) @map("is_verified")
  verificationToken    String?    @map("verification_token")
  resetPasswordToken   String?    @map("reset_password_token")
  resetPasswordExpires DateTime?  @map("reset_password_expires")
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)
  categories           Category[]
  menuItems            MenuItem[]
  qrCodes              QrCode[]

  @@map("admins")
}

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique @db.VarChar(100)
  createdBy String     @map("created_by") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  admin     Admin      @relation(fields: [createdBy], references: [id])
  menuItems MenuItem[]

  @@map("categories")
}

model MenuItem {
  id              String          @id @default(uuid()) @db.Uuid
  categoryId      String          @map("category_id") @db.Uuid
  createdBy       String          @map("created_by") @db.Uuid
  name            String          @unique @db.VarChar(150)
  slug            String?         @unique @db.VarChar(200)
  description     String?
  price           Decimal         @db.Decimal(10, 2)
  oldPrice        Decimal?        @map("old_price") @db.Decimal(10, 2)
  preparationTime Int?            @map("preparation_time")
  spicyLevel      Int?            @default(0) @map("spicy_level")
  isAvailable     Boolean         @default(true) @map("is_available")
  isFeatured      Boolean         @default(false) @map("is_featured")
  ingredients     String[]        @default([])
  allergens       String[]        @default([])
  calories        Int?
  protein         String?         @db.VarChar(20)
  carbs           String?         @db.VarChar(20)
  fat             String?         @db.VarChar(20)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamp(6)
  images          MenuItemImage[]
  category        Category        @relation(fields: [categoryId], references: [id])
  admin           Admin           @relation(fields: [createdBy], references: [id])
  ratings         Rating[]

  @@map("menu_items")
}

model MenuItemImage {
  id         String   @id @default(uuid()) @db.Uuid
  menuItemId String   @map("menu_item_id") @db.Uuid
  imageUrl   String   @map("image_url")
  isPrimary  Boolean  @default(false) @map("is_primary")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("menu_item_images")
}

model Rating {
  id           String   @id @default(uuid()) @db.Uuid
  menuItemId   String   @map("menu_item_id") @db.Uuid
  qrCodeId     String?  @map("qr_code_id") @db.Uuid
  ratingValue  Int      @map("rating_value")
  comment      String?
  customerName String?  @map("customer_name") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  qrCode       QrCode?  @relation(fields: [qrCodeId], references: [id])

  @@map("ratings")
}

model QrCode {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  shortId   String   @unique @map("short_id") @db.VarChar(20)
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  admin     Admin    @relation(fields: [createdBy], references: [id])
  scans     QrScan[]
  ratings   Rating[]

  @@map("qr_codes")
}

model QrScan {
  id        String   @id @default(uuid()) @db.Uuid
  qrCodeId  String   @map("qr_code_id") @db.Uuid
  scannedAt DateTime @default(now()) @map("scanned_at") @db.Timestamp(6)
  qrCode    QrCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@map("qr_scans")
}

enum Role {
  ADMIN
  STAFF
}
